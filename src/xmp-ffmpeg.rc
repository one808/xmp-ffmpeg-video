// Version resource for xmp-ffmpeg.dll - XMPlay reads this for its plugin
// update notifications (see the un4seen forum thread). @VERSION@ and
// @VERSIONNUM@ are substituted by scripts/build-plugin.sh from the VERSION
// file at the repository root.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSIONNUM@
 PRODUCTVERSION @VERSIONNUM@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "xmp-ffmpeg project"
            VALUE "FileDescription", "XMPlay input plugin - FFmpeg-based all-format playback with automatic video window"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "xmp-ffmpeg"
            VALUE "LegalCopyright", "GPL v3 or later"
            VALUE "OriginalFilename", "xmp-ffmpeg.dll"
            VALUE "ProductName", "xmp-ffmpeg"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

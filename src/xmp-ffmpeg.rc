// Version resource for xmp-ffmpeg.dll - XMPlay reads this for its plugin
// update notifications (see the un4seen forum thread). @VERSION@ and
// @VERSIONNUM@ are substituted by scripts/build-plugin.sh from the VERSION
// file at the repository root.

#include <winver.h>
#include <winres.h>

// vis config dialog (opened by the "FFmpeg video / lyrics" vis area's config
// button; handled by LrcConfigDialogProc in xmp-ffmpeg.cpp). Control ids:
//  201 service url, 202 download-online, 203 save-.lrc, 204 active-line colour,
//  209 normal colour, 205 font name, 206 font size, 207 time offset, 208 line
//  spacing.
1000 DIALOGEX 0, 0, 240, 166
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FFmpeg lyrics"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    CONTROL         "Lyrics service:", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | WS_GROUP, 8, 8, 55, 8
    EDITTEXT        201, 66, 7, 166, 12, ES_AUTOHSCROLL
    CONTROL         "Download lyrics online when missing", 202, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 24, 150, 10
    CONTROL         "Save downloaded lyrics as .lrc next to track", 203, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 37, 180, 10
    CONTROL         "Active line colour (RRGGBB):", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | WS_GROUP, 8, 53, 90, 8
    EDITTEXT        204, 102, 51, 40, 12, ES_UPPERCASE | ES_AUTOHSCROLL
    CONTROL         "Normal colour (RRGGBB):", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | WS_GROUP, 8, 68, 90, 8
    EDITTEXT        209, 102, 66, 40, 12, ES_UPPERCASE | ES_AUTOHSCROLL
    CONTROL         "Font name:", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | WS_GROUP, 8, 84, 40, 8
    EDITTEXT        205, 48, 82, 184, 12, ES_AUTOHSCROLL
    CONTROL         "Font size:", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | WS_GROUP, 8, 99, 40, 8
    EDITTEXT        206, 48, 97, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Time offset (0.1s):", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | WS_GROUP, 8, 114, 60, 8
    EDITTEXT        207, 48, 112, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Line spacing (px):", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | WS_GROUP, 8, 129, 60, 8
    EDITTEXT        208, 48, 127, 30, 12, ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "OK", IDOK, 78, 148, 50, 14, BS_DEFPUSHBUTTON
    PUSHBUTTON      "Cancel", IDCANCEL, 134, 148, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSIONNUM@
 PRODUCTVERSION @VERSIONNUM@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "xmp-ffmpeg project"
            VALUE "FileDescription", "XMPlay input plugin - FFmpeg-based all-format playback with automatic video window"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "xmp-ffmpeg"
            VALUE "LegalCopyright", "GPL v3 or later"
            VALUE "OriginalFilename", "xmp-ffmpeg.dll"
            VALUE "ProductName", "xmp-ffmpeg"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
